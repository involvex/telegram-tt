NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

BASE_URL=https://web.telegram.org/a/

# Optional trusted local HTTPS certs. Without these, development uses
# @vitejs/plugin-basic-ssl (self-signed; accept the browser warning on phone/LAN).
#
# Generate with the npm mkcert CLI (not FiloSottile mkcert):
#   mkdir certs
#   bunx mkcert create-ca --key certs/ca.key --cert certs/ca.crt
#   bunx mkcert create-cert --ca-key certs/ca.key --ca-cert certs/ca.crt --key certs/cert.key --cert certs/cert.crt --domains localhost 127.0.0.1 ::1 192.168.178.69
# Then install certs/ca.crt as a trusted root CA on this PC and your phone
# (Android: Settings → Security → Encryption & credentials → Install a certificate → CA certificate).
# Or open https://<lan-ip>:1234/dev-ca.crt on the phone after accepting the warning once.
# PWA "Install" stays disabled until the CA is trusted (padlock with no warning).
HTTPS_CERT_PATH=./certs/cert.crt
HTTPS_KEY_PATH=./certs/cert.key
