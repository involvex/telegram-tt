{
  "identifier": "default",
  "description": "Permissions available to Telegram app content",
  "local": true,
  "webviews": ["*"],
  "permissions": [
    "allow-set-notifications-count",
    "allow-save-current-url",
    "core:event:default",
    "process:default",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "biometric:default",
    "shell:default"
  ]
}
